generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Viewer
  Member
  Lead
  Admin
}

enum ItemType {
  Incident
  Customer_Issue
  Payment
  Compliance
  Task
}

enum Priority {
  Low
  Medium
  High
  Urgent
}

enum Status {
  Open
  In_Progress
  Awaiting_Approval
  Resolved
  Closed
}

enum EventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  PRIORITY_CHANGED
  FIELD_UPDATED
  COMMENT_ADDED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  name               String
  password           String
  isActive           Boolean         @default(true)
  memberships        Membership[]
  createdWorkItems   WorkItem[]      @relation("CreatedBy")
  assignedWorkItems  WorkItem[]      @relation("AssignedTo")
  comments           Comment[]
  activityEvents     ActivityEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([email])
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  memberships Membership[]
  workItems   WorkItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      Role     @default(Member)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@index([role])
}

model WorkItem {
  id             String          @id @default(uuid())
  title          String
  description    String          @db.Text
  type           ItemType        @default(Task)
  priority       Priority        @default(Medium)
  status         Status          @default(Open)
  teamId         String
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assigneeId     String?
  assignee       User?           @relation("AssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User            @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dueDate        DateTime?
  version        Int             @default(1)
  comments       Comment[]
  activityEvents ActivityEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([priority, status])
  @@index([status, updatedAt])
  @@index([createdAt])
}

model ActivityEvent {
  id         String    @id @default(uuid())
  workItemId String
  workItem   WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  eventType  EventType
  details    Json
  timestamp  DateTime  @default(now())

  @@index([workItemId, timestamp])
  @@index([actorId])
}

model Comment {
  id         String   @id @default(uuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([workItemId, createdAt])
}

model IdempotencyKey {
  id           String            @id @default(uuid())
  key          String            @unique
  userId       String
  endpoint     String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  status       IdempotencyStatus @default(IN_PROGRESS)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  expiresAt    DateTime

  @@index([key, userId])
  @@index([expiresAt])
}

model OutboxJob {
  id          String       @id @default(uuid())
  jobType     String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(3)
  lastError   String?      @db.Text
  nextRunAt   DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, nextRunAt])
}
